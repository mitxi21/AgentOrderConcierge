# Template for secrets.env — COMMIT THIS FILE, never the real one.
# Copy to secrets.env and fill in real values. secrets.env is in .gitignore.
#
# Load into a PowerShell session:   . .\load_secrets.ps1
# Then run, e.g.:                   cd src; py -3.8 run_eval.py eval_cases.yaml

# --- Salesforce Agent API (Phase 7) ---
# My Domain URL: the .my.salesforce.com form, not lightning.force.com
SF_MY_DOMAIN_URL=https://<my-domain>.my.salesforce.com
# BotDefinition Id (0Xx...), not a BotVersion Id (0X9...)
SF_AGENT_ID=0Xx...
# External Client App "Keyburn_ECA" -> Settings tab -> OAuth Settings
SF_CLIENT_ID=<consumer key>
SF_CLIENT_SECRET=<consumer secret>

# --- Google Maps Platform (Phase 9) ---
# Needs BOTH "Routes API" and "Maps Static API" enabled, and both allowed under the
# key's API restrictions. The key also has to exist inside the org (External Credential /
# custom metadata) for the Apex callout — this copy is for local testing only.
GOOGLE_MAPS_API_KEY=<api key>

# --- AWS Bedrock, Nova 2 Sonic (Phase 11) ---
# IAM access keys, NOT a Bedrock API key (ABSK...): API keys can't call
# InvokeModelWithBidirectionalStream. Minimal policy: bedrock-voice/iam-policy.json
AWS_REGION=eu-north-1
AWS_ACCOUNT_ID=<account id>
AWS_ACCESS_KEY_ID=<access key id>
AWS_SECRET_ACCESS_KEY=<secret access key>

# --- S3 bucket read by Data 360 (Phase 13) ---
# A separate IAM user from the Bedrock one above: read-only on this one bucket
# (s3:ListBucket + s3:GetBucketLocation on the bucket, s3:GetObject on its objects).
# These keys are also entered in the Data Cloud Amazon S3 connector. See s3-docs/README.md.
AWS_S3_BUCKET=<bucket name>
AWS_S3_ACCESS_KEY_ID=<access key id>
AWS_S3_SECRET_ACCESS_KEY=<secret access key>

# --- Git redaction filter (tools/setup_redaction.ps1) ---
# Org identifiers kept out of the public repo. Committed files carry the __TOKEN__ on the right;
# your working copy keeps the real value. Run tools/setup_redaction.ps1 once per clone.
# REDACT_X=value  <->  __X__ in the repo (e.g. REDACT_MY_DOMAIN <-> __MY_DOMAIN__).
REDACT_AGENT_USERNAME=<agent user username>
REDACT_AGENT_USER_ID=<005... 18-char user id>
REDACT_ORG_ID_18=<00D... 18-char org id>
REDACT_ORG_ID_15=<00D... 15-char org id>
# My Domain prefix, e.g. orgfarm-xxxx-dev-ed
REDACT_MY_DOMAIN=<my domain prefix>
REDACT_AWS_ACCOUNT_ID=<12-digit account id>
# Same value as SF_AGENT_ID
REDACT_AGENT_ID=<0Xx... BotDefinition id>
REDACT_ADMIN_USERNAME=<org admin username, used as siteAdmin in sites/*.site-meta.xml>
