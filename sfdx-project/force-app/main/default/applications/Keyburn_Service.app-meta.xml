<?xml version="1.0" encoding="UTF-8"?>
<!-- Demo app: the customer website (with the Agentforce chat) next to the service team's view of
     what the agent created - escalated Cases, Contacts and Orders (with the delivery map). -->
<CustomApplication xmlns="http://soap.sforce.com/2006/04/metadata">
    <brand>
        <headerColor>#E8531F</headerColor>
        <shouldOverrideOrgTheme>true</shouldOverrideOrgTheme>
    </brand>
    <description>Keyburn demo: the customer website with the Agentforce chat, and the service team's view of escalated Cases, Contacts and Orders.</description>
    <formFactors>Large</formFactors>
    <isNavAutoTempTabsDisabled>false</isNavAutoTempTabsDisabled>
    <isNavPersonalizationDisabled>false</isNavPersonalizationDisabled>
    <isNavTabPersistenceDisabled>false</isNavTabPersistenceDisabled>
    <label>Keyburn Service</label>
    <navType>Console</navType>
    <tabs>KeyburnHelp</tabs>
    <tabs>standard-Case</tabs>
    <tabs>standard-Contact</tabs>
    <tabs>Order__c</tabs>
    <tabs>Knowledge__kav</tabs>
    <tabs>OCC_Verification__c</tabs>
    <uiType>Lightning</uiType>
    <workspaceConfig>
        <mappings>
            <tab>KeyburnHelp</tab>
        </mappings>
        <mappings>
            <tab>standard-Case</tab>
        </mappings>
        <mappings>
            <tab>standard-Contact</tab>
        </mappings>
        <mappings>
            <tab>Order__c</tab>
        </mappings>
        <mappings>
            <tab>Knowledge__kav</tab>
        </mappings>
        <mappings>
            <tab>OCC_Verification__c</tab>
        </mappings>
    </workspaceConfig>
</CustomApplication>
