<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Phase 16: one row per verification attempt. Deliberately NOT fields on Contact: the agent
         permset is read-only on Contact, and this keeps it that way - the agent gets create/edit
         here only. The code itself is never stored, only a salted SHA-256 hash. -->
    <label>Verification</label>
    <pluralLabel>Verifications</pluralLabel>
    <nameField>
        <label>Verification Name</label>
        <type>AutoNumber</type>
        <displayFormat>VER-{00000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
</CustomObject>
