<?xml version="1.0" encoding="UTF-8"?>
<!-- Metadata-API-format deploy of ONE list view on the standard Case object. The source-format
     project has no Case.object-meta.xml parent (deliberately), which the CLI requires for a
     source-format ListView, so this file is the source of truth. Deploy this folder with
     sf project deploy start and the metadata-dir flag (see CLAUDE.md, Commands). -->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <listViews>
        <fullName>Agentforce_Escalations</fullName>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>CASES.SUBJECT</columns>
        <columns>NAME</columns>
        <columns>CASES.PRIORITY</columns>
        <columns>CASES.STATUS</columns>
        <columns>CASES.CREATED_DATE_DATE_ONLY</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CASES.SUBJECT</field>
            <operation>startsWith</operation>
            <value>Agent escalation</value>
        </filters>
        <label>Agentforce Escalations</label>
    </listViews>
</CustomObject>
